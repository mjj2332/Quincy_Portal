{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quincy-web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "portal",
        "run",
        "dev",
        "-w",
        "@quincy/web"
      ],
      "port": 5173
    },
    {
      "name": "quincy-app-worker-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--config",
        "portal/workers/app/wrangler.jsonc",
        "--port",
        "8787"
      ],
      "port": 8787
    }
  ]
}
