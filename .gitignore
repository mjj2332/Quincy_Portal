# macOS
.DS_Store

# Editor / tooling
.claude/
.vscode/
.idea/

# Logs
*.log

# Local environment variables (holds the ReUI license key — never commit)
.env.local

# Per-user MCP config: carries a personal ReUI bearer token. The token-free server
# definition lives in .cursor/mcp.json and opencode.json, which ARE committed.
.mcp.json

# Design handoff bundles
*.zip

# Local media fixtures (~614 MB — never commit). Live in test-data/ and are referenced by
# the portal XMP test, which skips when they're absent (see test-data/README.md).
Test Images with star rating/

# Wrangler local state (any level)
.wrangler/

# Unrelated local tool scaffolding, not project content
.agents/

# Local QA screenshots / evidence — transient, not part of the software project
qa-evidence/

# Scratch evaluation projects. Holds a commercially-licensed ReUI template and its
# license key; the licence forbids sharing outside the organisation. Reference only,
# never production code — see issue #48.
tmp/

# Agent scratch space — planning briefs, subagent specs and reports. Working notes for a slice,
# never part of the software project. The durable conclusions belong in docs/ or a commit message.
scratchpad/
