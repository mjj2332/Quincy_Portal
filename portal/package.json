{
  "name": "quincy-portal",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/db",
    "apps/web",
    "workers/app",
    "workers/background",
    "workers/webhook-ingress"
  ],
  "scripts": {
    "dev": "npm run dev -w @quincy/web",
    "build": "npm run build -w @quincy/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run generate -w @quincy/db",
    "db:migrate:local": "npm run migrate:local -w @quincy/db"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fullcalendar/core": "7.0.2",
    "@fullcalendar/react": "7.0.2",
    "@floating-ui/react": "0.27.16",
    "@tanstack/react-query": "5.102.3",
    "@tiptap/core": "3.30.2",
    "@tiptap/extension-hard-break": "3.30.2",
    "@tiptap/extension-list": "3.30.2",
    "@tiptap/extension-mention": "3.30.2",
    "@tiptap/pm": "3.30.2",
    "@tiptap/react": "3.30.2",
    "@tiptap/starter-kit": "3.30.2",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.23",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "temporal-polyfill": "1.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
