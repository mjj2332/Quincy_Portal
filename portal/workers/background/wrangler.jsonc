{
  // Background Worker — Queue consumers, Workflows (autoHDR round-trip, zip builds),
  // Dropbox sync engine + DropboxSync Durable Object (cursor/delta loop).
  // Deployed FIRST in CI (other workers bind to it by name).
  "name": "quincy-portal-background",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Account is on Workers Paid (upgraded 2026-07-25), so the default 10,000 subrequests/request
  // applies and a "limits" block is accepted if ever needed. It is deliberately omitted: nothing
  // here needs a non-default ceiling, and MAX_DOWNLOADS_PER_RUN (src/dropbox/sync.ts) already
  // keeps a run near ~1,080-1,200 subrequests. Note a "limits" block is rejected outright on the
  // Free plan ("CPU limits are not supported for the Free plan", code 100328) and fails the
  // entire deploy — and `wrangler deploy --dry-run` does NOT catch it. See docs/lessons.md.
  // Intentionally retained until Dropbox RAW automation is verified live before a later retirement deploy.
  "triggers": { "crons": ["0 * * * *", "* * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "quincy-portal", "database_id": "1d36b42e-f1e6-4659-8c9e-70afe822b6fa" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "quincy-portal-media" }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ],
  "queues": {
    "consumers": [
      { "queue": "quincy-ingest", "max_batch_size": 1, "max_concurrency": 1, "max_retries": 3 },
      { "queue": "quincy-renditions", "max_batch_size": 1, "max_concurrency": 1, "max_retries": 3, "dead_letter_queue": "quincy-renditions-dlq" },
      { "queue": "quincy-renditions-dlq", "max_batch_size": 10, "max_retries": 3 },
      { "queue": "quincy-notifications", "max_batch_size": 1, "max_concurrency": 1, "max_retries": 3, "dead_letter_queue": "quincy-notifications-dlq" },
      { "queue": "quincy-notifications-dlq", "max_batch_size": 10, "max_retries": 3 }
    ],
    "producers": [
      { "binding": "INGEST_QUEUE", "queue": "quincy-ingest" },
      { "binding": "RENDITION_QUEUE", "queue": "quincy-renditions" },
      { "binding": "NOTIFICATION_QUEUE", "queue": "quincy-notifications" }
    ]
  },
  "workflows": [
    {
      "binding": "AUTOHDR_WORKFLOW",
      "name": "quincy-autohdr-roundtrip",
      "class_name": "AutoHdrSend"
    },
    {
      "binding": "AUTOHDR_API_SEND_WORKFLOW",
      "name": "quincy-autohdr-api-send",
      "class_name": "AutoHdrApiSend"
    },
    {
      "binding": "AUTOHDR_FETCH_WORKFLOW",
      "name": "quincy-autohdr-fetch",
      "class_name": "AutoHdrFetch"
    },
    {
      "binding": "MANUAL_EDITED_PUBLISH_WORKFLOW",
      "name": "quincy-manual-edited-publish",
      "class_name": "ManualEditedPublish"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DROPBOX_SYNC", "class_name": "DropboxSyncDO" },
      { "name": "TONOMO_PROCESSOR", "class_name": "TonomoProcessorDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DropboxSyncDO"] },
    { "tag": "v2", "new_sqlite_classes": ["TonomoProcessorDO"] }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://quincy.flamingfire.my",
    // CLOUDFLARE_ZONE_ID and CLOUDFLARE_CACHE_PURGE_TOKEN are background-only secrets;
    // provision them with `wrangler secret put`, never as committed vars.
    "RENDITIONS_ENABLED": true,
    "DROPBOX_RAW_AUTOMATION_ENABLED": "1",
    "DROPBOX_AUTOHDR_AUTOMATION_ENABLED": "1"
  }
}
