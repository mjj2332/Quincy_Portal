{
  // Staff app/API Worker — Hono + better-auth (Google-only) + serves the SPA.
  // Cloudflare bindings are production resources; local tests simulate them through Miniflare.
  "name": "quincy-portal-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "limits": { "cpu_ms": 30000 },
  // #359: deploy the app Worker minified; source maps upload so Workers Logs stack traces stay readable.
  "minify": true,
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/media", "/media/*", "/__transform-source", "/__transform-source/*", "/d", "/d/*", "/assets/*", "/oauth/*", "/mcp", "/mcp/*", "/dl", "/dl/*", "/.well-known/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "quincy-portal", "database_id": "1d36b42e-f1e6-4659-8c9e-70afe822b6fa", "migrations_dir": "../../packages/db/migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "quincy-portal-media" }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "1344f43c2da84b28bc8729ac15c36925" },
    { "binding": "OAUTH_KV", "id": "8f755548fe4049538916612a12dbf448" }
  ],
  // #703: per-connection limits on /mcp tools/call (ADR 0019). Namespace ids are account-wide: keep them unique.
  "ratelimits": [
    { "name": "MCP_CALLS", "namespace_id": "703001", "simple": { "limit": 60, "period": 60 } },
    { "name": "MCP_WRITES", "namespace_id": "703002", "simple": { "limit": 20, "period": 60 } }
  ],
  "queues": {
    "producers": [
      { "binding": "INGEST_QUEUE", "queue": "quincy-ingest" },
      { "binding": "RENDITION_QUEUE", "queue": "quincy-renditions" },
      { "binding": "NOTIFICATION_QUEUE", "queue": "quincy-notifications" }
    ]
  },
  // #498 (ADR 0017): one Durable Object per Project holds its whiteboard. Migration tags are per
  // Worker; `wrangler deploy` applies this one. See docs/Guides/CI-Deploy.md: Cloudflare cannot roll
  // back across a Durable Object migration, so the first version with this class is the rollback floor.
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT_WHITEBOARD", "class_name": "ProjectWhiteboardDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectWhiteboardDO"] }
  ],
  "services": [
    { "binding": "BACKGROUND", "service": "quincy-portal-background" }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://quincy.flamingfire.my",
    "RENDITIONS_ENABLED": true,
    "DROPBOX_EDITOR_AUTOMATION_ENABLED": "1"
  }
}
