{
  // Thin PUBLIC webhook-ingress Worker — signature validation only, no assets, no galleries.
  // Phase 2: /webhooks/dropbox. Phase 3: /webhooks/tonomo/*.
  "name": "quincy-portal-webhook-ingress",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "quincy-portal", "database_id": "1d36b42e-f1e6-4659-8c9e-70afe822b6fa" }
  ],
  "services": [
    { "binding": "BACKGROUND", "service": "quincy-portal-background" }
  ],
  "vars": {
    "APP_ENV": "production"
  }
}
